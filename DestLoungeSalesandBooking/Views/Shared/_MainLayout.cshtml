        }


        .notif-item:last-child {
            border-bottom: none;
        }

        .notif-item:hover {
            background-color: #f0e6da;
        }

    /* ── Item Icon ── */
    .notif-icon-wrap {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #ede3d9;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #6b4423;
        font-size: 0.85rem;
    }
    [ng-show="showNotif"] {
        max-height: 350px !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        position: absolute !important;
    }

        [ng-show="showNotif"]::-webkit-scrollbar {
            width: 6px;
        }

        [ng-show="showNotif"]::-webkit-scrollbar-track {
            background: #f5ece4;
            border-radius: 10px;
        }

        [ng-show="showNotif"]::-webkit-scrollbar-thumb {
            background: #c4a882;
            border-radius: 10px;
        }
        @@media (max-width: 1024px) {
    /* Pull the notification bell div out of the mobile nav flow
       and position it in the header, next to the hamburger */
    .mobile-nav-actions > div[ng-controller] {
        position: fixed !important;
        top: 0 !important;
        right: 52px !important; /* sits just left of the hamburger button */
        height: 60px !important; /* match your header height */
        display: flex !important;
        align-items: center !important;
        z-index: 1100 !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        background: none !important;
        width: auto !important;
    }

    /* Style the bell anchor/button inside it */
    .mobile-nav-actions > div[ng-controller] > a {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 20px !important;
        color: #5d4037 !important;
        padding: 6px !important;
        width: auto !important;
        border-bottom: none !important;
        background: none !important;
        gap: 0 !important;
    }

    /* Hide the "Notifications" text label, keep only the icon */
    .mobile-nav-actions > div[ng-controller] > a > .fa-bell {
        font-size: 20px !important;
    }

    .mobile-nav-actions > div[ng-controller] > a span:not(.notif-badge) {
        display: none !important;
    }

    /* Keep the dropdown anchored correctly */
    .mobile-nav-actions > div[ng-controller] > div[ng-show] {
        position: fixed !important;
        top: 60px !important; /* below header */
        right: 10px !important;
        left: auto !important;
        width: 280px !important;
    }
}
        /* ── MOBILE: Hide bell from inside hamburger menu ── */
@@media (max-width: 1024px) {

    /* 1. Hide the bell container that's inside the mobile nav */
    .mobile-nav-actions .notif-wrapper {
        display: none !important;
    }

    /* 2. Show a separate bell that lives OUTSIDE the hamburger,
          fixed in the header next to it */
    .header-bell-fixed {
        display: flex !important;
        position: fixed;
        top: 0;
        right: 52px; /* adjust if your hamburger button width differs */
        height: 60px; /* match your header height */
        align-items: center;
        z-index: 1100;
    }
}

/* On desktop, hide the fixed-position duplicate */
@@media (min-width: 1025px) {
    .header-bell-fixed {
        display: none !important;
    }
}
/* ── Header container ── */
.header-container {
    display: flex;
    align-items: center;
    /* logo on left, nav in middle, header-right on right */
    justify-content: space-between;
    padding: 0 1.5rem;
    height: 64px;          /* give it a fixed height so nothing jumps */
    position: relative;    /* anchor for any absolutely-positioned children */
}

/* ── Logo ── */
.logo {
    flex-shrink: 0;
}

/* ── Main nav ── */
/* Desktop: sits between logo and header-right */
.main-nav {
    flex: 1;
    /* desktop styles applied via @@media below */
}

/* ── RIGHT GROUP — bell + hamburger, always visible ── */
.header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;          /* space between login / bell / hamburger */
    flex-shrink: 0;
    z-index: 1050;         /* above overlay (900) and nav drawer (1000), but
                              hamburger itself gets 1100 so it stays tappable
                              even when the drawer is open */
}

/* ── Notification wrapper — positions the dropdown ── */
.notif-wrapper {
    position: relative;    /* dropdown anchors to THIS, not the header */
}

.notif-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 22px;
    color: #5d4037;
    position: relative;    /* for the badge */
    display: flex;
    align-items: center;
    padding: 0.25rem;
    line-height: 1;
}

.notif-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    background: #e74c3c;
    color: white;
    font-size: 9px;
    font-weight: 700;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.notif-dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);  /* 8px gap below the bell button */
    width: 280px;
    max-height: 350px;
    overflow-y: auto;
    background: white;
    border: 1px solid #ccc;
    border-radius: 10px;
    z-index: 99999;          /* on top of everything */
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.notif-header {
    padding: 10px 12px;
    font-weight: bold;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #333;
}

.notif-clear-btn {
    font-size: 11px;
    color: #e74c3c;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.notif-empty {
    padding: 12px;
    color: gray;
    font-size: 13px;
    text-align: center;
}

.notif-item {
    padding: 10px 12px;
    border-bottom: 1px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
}

.notif-message {
    cursor: pointer;
    flex: 1;
    line-height: 1.4;
    font-size: 13px;
}
.notif-message--read   { color: #999; font-weight: normal; }
.notif-message--unread { color: #333; font-weight: 600; }

.notif-delete-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #aaa;
    font-size: 16px;
    padding: 0 0 0 6px;
    flex-shrink: 0;
    line-height: 1;
}

/* ── Hamburger ── */
.hamburger-btn {
    display: none;          /* hidden on desktop, shown on tablet/mobile */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    z-index: 1100;          /* above bell dropdown so it's always tappable */
    flex-shrink: 0;
}
.hamburger-btn span {
    display: block;
    width: 26px;
    height: 3px;
    background-color: #5d4037;
    border-radius: 3px;
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
    transform-origin: center;
}
.hamburger-btn.open span:nth-child(1) { transform: translateY(8px)  rotate(45deg); }
.hamburger-btn.open span:nth-child(2) { opacity: 0; width: 0; }
.hamburger-btn.open span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

/* ── Nav overlay ── */
.nav-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0,0,0,0.4);
    z-index: 900;           /* below nav (1000) and bell (1050) */
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}
.nav-overlay.active {
    opacity: 1;
    pointer-events: all;
}

.mobile-nav-actions { display: none; }

/* ═══════════════════════════════════════════
   DESKTOP (≥ 1025px)
═══════════════════════════════════════════ */
@@media (min-width: 1025px) {
    .hamburger-btn        { display: none !important; }
    .mobile-nav-actions   { display: none !important; }
    .nav-overlay          { display: none !important; }

    .main-nav {
        position: static !important;
        transform: none !important;
        width: auto !important;
        height: auto !important;
        background: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin-left: 3rem !important;
        margin-right: auto !important;   /* pushes .header-right to far right */
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 2.5rem !important;
        overflow: visible !important;
        transition: none !important;
    }
    .main-nav a {
