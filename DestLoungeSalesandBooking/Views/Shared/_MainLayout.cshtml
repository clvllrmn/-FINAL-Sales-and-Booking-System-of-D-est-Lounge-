    .notif-item.read {
        background-color: #f9f9f9;
        opacity: 0.6;
        font-weight: normal;
        color: #888;
    }

    /* Unread orange dot */
    .notif-unread-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        background: #e67e22;
        border-radius: 50%;
        margin-right: 6px;
        vertical-align: middle;
        flex-shrink: 0;
    }
    /* ── Dropdown ── */

    .notif-items-scroll {
        overflow-y: auto;
        flex: 1;
    }

        .notif-items-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .notif-items-scroll::-webkit-scrollbar-track {
            background: #f5ece4;
            border-radius: 10px;
        }

        .notif-items-scroll::-webkit-scrollbar-thumb {
            background: #c4a882;
            border-radius: 10px;
        }

        .notif-empty i {
            font-size: 2rem;
            color: #c4b09a;
        }

        .notif-empty p {
